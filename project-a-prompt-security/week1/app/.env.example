# Copy this file to .env in this directory, then fill in the key.
# Never commit .env. Never paste keys into chat.
#
# Free Groq key: https://console.groq.com/keys
# Groq is OpenAI-compatible — BASE_URL/MODEL defaults below work as-is.

# Required for live LLM (also accepted: GROQ_API_KEY)
LLM_API_KEY=

# Optional — defaults shown (Groq free tier)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
